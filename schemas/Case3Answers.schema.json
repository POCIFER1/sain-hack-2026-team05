{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case3Answers",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "weeks"
  ],
  "properties": {
    "weeks": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "record_id",
          "profile",
          "hypotheses"
        ],
        "properties": {
          "record_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "profile": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "chronotype",
              "weekday_bedtime",
              "weekday_wake_time",
              "average_sleep_hours",
              "social_jetlag",
              "activity_level",
              "sedentary_hours",
              "training_days",
              "works_from_home",
              "phone_before_sleep",
              "movement_index"
            ],
            "properties": {
              "chronotype": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "value",
                  "confidence"
                ],
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "const": "early",
                            "type": "string"
                          },
                          {
                            "const": "intermediate",
                            "type": "string"
                          },
                          {
                            "const": "late",
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "confidence": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  }
                }
              },
              "weekday_bedtime": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "value",
                  "confidence"
                ],
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                        "type": "string"
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "confidence": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  }
                }
              },
              "weekday_wake_time": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "value",
                  "confidence"
                ],
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                        "type": "string"
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "confidence": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  }
                }
              },
              "average_sleep_hours": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "value",
                  "confidence"
                ],
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "minimum": 0,
                        "maximum": 24,
                        "type": "number"
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "confidence": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  }
                }
              },
              "social_jetlag": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "value",
                  "confidence"
                ],
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "confidence": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  }
                }
              },
              "activity_level": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "value",
                  "confidence"
                ],
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "const": "low",
                            "type": "string"
                          },
                          {
                            "const": "medium",
                            "type": "string"
                          },
                          {
                            "const": "high",
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "confidence": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  }
                }
              },
              "sedentary_hours": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "value",
                  "confidence"
                ],
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "const": "lt6",
                            "type": "string"
                          },
                          {
                            "const": "6to9",
                            "type": "string"
                          },
                          {
                            "const": "gt9",
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "confidence": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  }
                }
              },
              "training_days": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "value",
                  "confidence"
                ],
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "const": "0",
                            "type": "string"
                          },
                          {
                            "const": "1to2",
                            "type": "string"
                          },
                          {
                            "const": "3plus",
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "confidence": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  }
                }
              },
              "works_from_home": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "value",
                  "confidence"
                ],
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "confidence": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  }
                }
              },
              "phone_before_sleep": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "value",
                  "confidence"
                ],
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "confidence": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  }
                }
              },
              "movement_index": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "value",
                  "confidence"
                ],
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "const": "lt50",
                            "type": "string"
                          },
                          {
                            "const": "50to70",
                            "type": "string"
                          },
                          {
                            "const": "70to85",
                            "type": "string"
                          },
                          {
                            "const": "85plus",
                            "type": "string"
                          }
                        ]
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "confidence": {
                    "minimum": 0,
                    "maximum": 1,
                    "type": "number"
                  }
                }
              }
            }
          },
          "hypotheses": {
            "minItems": 3,
            "maxItems": 3,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "text",
                "confidence"
              ],
              "properties": {
                "text": {
                  "minLength": 1,
                  "type": "string"
                },
                "confidence": {
                  "minimum": 0,
                  "maximum": 1,
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
